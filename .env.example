# ─── PostgreSQL Configuration ──────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password
POSTGRES_DB=etl_db

# ─── SQLAlchemy / psycopg2 Connection String ────────────────────────────────────
DATABASE_URL=postgresql://etl_user:etl_password@db:5432/etl_db

# ─── Mock API ──────────────────────────────────────────────────────────────────
MOCK_API_HOST=mock-api
MOCK_API_PORT=8080
MOCK_API_URL=http://mock-api:8080

# ─── Orchestrator Settings ─────────────────────────────────────────────────────
# Interval in seconds between orchestrator runs (default: 60)
ORCHESTRATOR_INTERVAL=60
# Set to "true" to run only once and exit (useful for testing/CI)
RUN_ONCE=false
